# Порт API (по умолчанию 4000)
PORT=4000

# Секрет для подписи JWT. ОБЯЗАТЕЛЬНО замените в production.
JWT_SECRET=change-me-to-a-long-random-string

# Разрешённые источники frontend в dev-режиме (через запятую).
# В production клиент отдаётся с того же адреса, поэтому CORS не применяется.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Данные администратора для seed-скрипта (демо)
SEED_ADMIN_EMAIL=admin@ustaz.kg
SEED_ADMIN_PASSWORD=Admin1234!
